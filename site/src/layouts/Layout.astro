---
import '../styles/global.css';
import PencilDefs from '../components/sketch/PencilDefs.astro';
import { withBase } from '../lib/base';
// Preload the fonts the first paint needs, so the swap does not move the hero.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import handUrl from '@fontsource-variable/caveat/files/caveat-latin-wght-normal.woff2?url';
const preload = [frauncesUrl, interUrl, monoUrl, handUrl];
// Browsers cache favicons apart from the page, so a hard reload does not refetch
// them; bump this when the icon files change.
const iconVersion = 2;
const icon = (name: string): string => `${withBase(name)}?v=${iconVersion}`;

interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>
            document.documentElement.classList.add('js');
        </script>
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
        {preload.map((href) => (
            <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
        ))}
        <link rel="icon" href={icon('favicon.svg')} type="image/svg+xml" />
        <link rel="icon" href={icon('favicon-32.png')} sizes="32x32" type="image/png" />
        <link rel="apple-touch-icon" href={icon('apple-touch-icon.png')} />
        <meta name="theme-color" content="#f6f1e7" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <a class="skip-link" href="#main">
            Skip to content
        </a>
        <PencilDefs />
        <slot />
        <script>
            import { initStrokeDraw } from '../scripts/stroke-draw';
            initStrokeDraw();
        </script>
    </body>
</html>
