---
/* Crimson again: the shore plate as a band, then links and the credits every
   engraving on the page earned. Credits come from the image manifest. */
import { images } from '../data/images.generated';
import { repo, pypi, version } from '../data/commands';
import Halftone from './Halftone.astro';
const credits = Object.values(images).map((i) => i.credit);
const seen = new Set<string>();
const unique = credits.filter((c) => (seen.has(c.page_url) ? false : (seen.add(c.page_url), true)));
---

<footer class="footer" id="footer">
    <div class="footer__band" aria-hidden="true">
        <Halftone id="shore" tone="crimson" hover={false} sizes="100vw" />
    </div>
    <div class="page footer__grid">
        <div class="footer__col">
            <p class="footer__name">
                proofpath <span class="footer__version">v{version}</span>
            </p>
            <p class="footer__tag">Don't guess. Show the evidence.</p>
            <ul class="footer__links">
                <li>
                    <a href={repo} rel="noopener">
                        GitHub
                    </a>
                </li>
                <li>
                    <a href={pypi} rel="noopener">
                        PyPI
                    </a>
                </li>
                <li>
                    <a href={`${repo}/blob/main/CHANGELOG.md`} rel="noopener">
                        Changelog
                    </a>
                </li>
                <li>
                    <a href={`${repo}/blob/main/LICENSE`} rel="noopener">
                        Licence
                    </a>
                </li>
            </ul>
        </div>
        <details class="footer__col footer__credits">
            <summary class="footer__credits-title">Engravings on this page</summary>
            <ul>
                {unique.map((c) => (
                    <li>
                        <a href={c.page_url} rel="noopener">
                            {c.author}, <cite>{c.title}</cite>
                            {c.year ? `, ${c.year}` : ''}
                        </a>
                        <span class="footer__licence">
                            {' '}
                            — {c.source},{' '}
                            <a href={c.licence_url} rel="noopener">
                                {c.licence}
                            </a>
                        </span>
                    </li>
                ))}
            </ul>
            <p class="footer__note">
                Halftoned at build time from the originals. The pencil lines are drawn in SVG; the
                ravens are Huginn and Muninn, who fly out each morning and come back with what they
                saw.
            </p>
        </details>
    </div>
</footer>

<style>
    .footer {
        --field: var(--crimson);
        --pen: var(--rose-soft);
        --caption: var(--rose-soft);
        background: var(--crimson);
        color: var(--paper);
        padding-bottom: var(--space-7);
    }
    .footer__band {
        max-height: 46vh;
        overflow: hidden;
        border-bottom: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
        mask-image: linear-gradient(to bottom, black 70%, transparent);
    }
    .footer__band :global(.halftone) {
        aspect-ratio: auto;
        max-height: 46vh;
    }
    .footer__band :global(img) {
        object-position: center 30%;
        max-height: 46vh;
    }
    .footer__grid {
        display: grid;
        gap: var(--space-6);
        padding-top: var(--space-7);
    }
    @media (min-width: 48rem) {
        .footer__grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
            gap: var(--space-8);
        }
    }
    .footer a {
        color: inherit;
    }
    .footer__name {
        font-family: var(--font-display);
        font-size: var(--step-3);
        margin: 0 0 var(--space-2);
        font-variation-settings:
            'opsz' 48,
            'WONK' 1;
    }
    .footer__version {
        color: var(--rose-soft);
        font-family: var(--font-mono);
        font-size: var(--step--1);
        margin-left: 0.4em;
    }
    .footer__tag {
        font-family: var(--font-display);
        font-style: italic;
    }
    .footer__links {
        list-style: none;
        padding: 0;
        margin: var(--space-4) 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        font-size: var(--step--1);
    }
    .footer__credits {
        font-size: var(--step--1);
    }
    /* Folded by default so the two columns sit at one height; the title is the
       handle, with the pen's own caret beside it. */
    .footer__credits-title {
        font-family: var(--font-display);
        font-size: var(--step-1);
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
    }
    .footer__credits-title::-webkit-details-marker {
        display: none;
    }
    .footer__credits-title::after {
        content: '+';
        font-family: var(--font-mono);
        font-size: var(--step--1);
        color: var(--rose-soft);
        transition: transform 160ms ease;
    }
    .footer__credits[open] .footer__credits-title {
        margin-bottom: var(--space-3);
    }
    .footer__credits[open] .footer__credits-title::after {
        transform: rotate(45deg);
    }
    .footer__credits-title:focus-visible {
        outline: 2px solid var(--rose-soft);
        outline-offset: 4px;
    }
    .footer__credits ul {
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-4);
        display: grid;
        gap: var(--space-2);
    }
    .footer__licence {
        color: var(--rose-soft);
    }
    .footer__note {
        color: var(--rose-soft);
        max-width: 56ch;
    }
</style>
