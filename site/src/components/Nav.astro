---
/* Sticky, quiet. Sits on whichever field is behind it and inherits its ink. */
import { repo } from '../data/commands';

const links = [
    { href: '#run', label: 'A run' },
    { href: '#levels', label: 'Three questions' },
    { href: '#rules', label: 'Rules' },
    { href: '#install', label: 'Install' },
];
---

<header class="nav">
    <div class="page nav__row">
        <a class="nav__brand" href="#top" aria-label="proofpath, back to top">
            <span class="nav__name">proofpath</span>
        </a>
        <nav class="nav__links" aria-label="Sections">
            {links.map((l) => (
                <a href={l.href} data-nav>
                    <span>{l.label}</span>
                    <svg
                        class="nav__ul"
                        viewBox="0 0 200 8"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                        focusable="false"
                    >
                        <path d="M2 5 C 40 2.5, 80 6.5, 120 4 S 180 3, 198 5.5"></path>
                    </svg>
                </a>
            ))}
            <a href={repo} rel="noopener">
                <span>GitHub</span>
                <svg
                    class="nav__ul"
                    viewBox="0 0 200 8"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                >
                    <path d="M2 5 C 40 2.5, 80 6.5, 120 4 S 180 3, 198 5.5"></path>
                </svg>
            </a>
        </nav>
    </div>
</header>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(6px);
        background: color-mix(in srgb, var(--field, var(--paper)) 82%, transparent);
        border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    }
    .nav__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        min-height: 3.5rem;
    }
    .nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: inherit;
        text-decoration: none;
        font-family: var(--font-display);
        font-size: var(--step-1);
        font-variation-settings:
            'opsz' 24,
            'WONK' 1;
    }
    .nav__brand:hover {
        text-decoration: none;
        color: inherit;
    }
    .nav__links {
        display: flex;
        gap: clamp(0.75rem, 2.5vw, 1.75rem);
        font-size: var(--step--1);
    }
    .nav__links a {
        position: relative;
        display: inline-block;
        color: inherit;
        text-decoration: none;
        padding-block: 0.25rem;
    }
    .nav__ul {
        position: absolute;
        left: -0.1em;
        right: -0.1em;
        bottom: -0.05em;
        width: calc(100% + 0.2em);
        height: 0.32em;
        overflow: visible;
        filter: url(#pencil-soft);
        pointer-events: none;
    }
    .nav__ul path {
        fill: none;
        stroke: currentColor;
        stroke-width: var(--stroke-bold);
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 240;
        stroke-dashoffset: 240;
        transition: stroke-dashoffset 320ms var(--ease-pen);
    }
    .nav__links a:hover .nav__ul path,
    .nav__links a:focus-visible .nav__ul path,
    .nav__links a[aria-current='true'] .nav__ul path {
        stroke-dashoffset: 0;
    }
    @media (prefers-reduced-motion: reduce) {
        .nav__ul path {
            stroke-dasharray: none;
            opacity: 0;
            transition: opacity 0.01ms;
        }
        .nav__links a:hover .nav__ul path,
        .nav__links a:focus-visible .nav__ul path,
        .nav__links a[aria-current='true'] .nav__ul path {
            opacity: 1;
        }
    }
    @media (max-width: 40rem) {
        .nav__links a:not(:last-child):not([data-nav='']) {
            display: none;
        }
        .nav__links [data-nav]:not([href='#install']) {
            display: none;
        }
    }
</style>
