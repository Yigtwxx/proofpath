---
/* Sticky, quiet. Sits on whichever field is behind it and inherits its ink. */
import { repo } from '../data/commands';
const links = [
    { href: '#run', label: 'A run' },
    { href: '#levels', label: 'Three questions' },
    { href: '#rules', label: 'Rules' },
    { href: '#install', label: 'Install' },
];
---

<header class="nav">
    <div class="page nav__row">
        <a class="nav__brand" href="#top" aria-label="proofpath, back to top">
            <span class="nav__name">proofpath</span>
        </a>
        <nav class="nav__links" aria-label="Sections">
            {links.map((l) => (
                <a href={l.href} data-nav>
                    {l.label}
                </a>
            ))}
            <a href={repo} rel="noopener">
                GitHub
            </a>
        </nav>
    </div>
</header>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(6px);
        background: color-mix(in srgb, var(--field, var(--paper)) 82%, transparent);
        border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    }
    .nav__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        min-height: 3.5rem;
    }
    .nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: inherit;
        text-decoration: none;
        font-family: var(--font-display);
        font-size: var(--step-1);
        font-variation-settings:
            'opsz' 24,
            'WONK' 1;
    }
    .nav__brand:hover {
        text-decoration: none;
        color: inherit;
    }
    .nav__links {
        display: flex;
        gap: clamp(0.75rem, 2.5vw, 1.75rem);
        font-size: var(--step--1);
    }
    .nav__links a {
        color: inherit;
        text-decoration: none;
        padding-block: 0.25rem;
        border-bottom: var(--stroke) solid transparent;
    }
    .nav__links a:hover,
    .nav__links a[aria-current='true'] {
        border-bottom-color: currentColor;
    }
    @media (max-width: 40rem) {
        .nav__links a:not(:last-child):not([data-nav='']) {
            display: none;
        }
        .nav__links [data-nav]:not([href='#install']) {
            display: none;
        }
    }
</style>
