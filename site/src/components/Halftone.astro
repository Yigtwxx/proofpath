---
/* A dithered engraving from the manifest. Two-level PNGs with a transparent
   tone, so the field behind decides the second colour; the `dense` variant is
   cross-faded in on hover, which reads as the print darkening under the hand. */
import { images, type GeneratedImage, type ImageId, type Tone } from '../data/images.generated';

interface Props {
    id: ImageId;
    tone?: Tone;
    sizes?: string;
    hover?: boolean;
    loading?: 'eager' | 'lazy';
    /** Fade the edges out, for a detail lifted from a larger plate. */
    vignette?: boolean;
    class?: string;
}
const {
    id,
    tone = 'paper',
    sizes = '(min-width: 64rem) 40vw, 90vw',
    hover = true,
    loading = 'lazy',
    vignette = false,
    class: className,
} = Astro.props;
const image: GeneratedImage = images[id];
const set = image.variants[tone];
const dense = image.variants[`${tone}-dense`];
if (!set)
    throw new Error(`image "${id}" has no "${tone}" variant; add the tone to images.manifest.json`);
const srcset = Object.entries(set)
    .map(([w, src]) => `${src} ${w}w`)
    .join(', ');
const denseSrcset = dense
    ? Object.entries(dense)
          .map(([w, src]) => `${src} ${w}w`)
          .join(', ')
    : null;
const fallback = set[720] ?? Object.values(set)[0];
const width = 720;
const height = Math.round(720 / image.aspect);
---

<span
    class:list={[
        'halftone',
        { 'halftone--hover': hover && denseSrcset, 'halftone--vignette': vignette },
        className,
    ]}
    style={`--aspect: ${image.aspect}`}
>
    <img
        class="halftone__img"
        src={fallback}
        srcset={srcset}
        sizes={sizes}
        width={width}
        height={height}
        alt={image.alt}
        loading={loading}
        decoding="async"
    />
    {hover && denseSrcset ? (
        <img
            class="halftone__img halftone__img--dense"
            src={dense![720] ?? Object.values(dense!)[0]}
            srcset={denseSrcset}
            sizes={sizes}
            width={width}
            height={height}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
        />
    ) : null}
</span>

<style>
    .halftone {
        position: relative;
        display: block;
        aspect-ratio: var(--aspect);
        overflow: hidden;
    }
    .halftone__img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        image-rendering: auto;
    }
    .halftone--vignette {
        mask-image: radial-gradient(ellipse 62% 58% at 50% 50%, black 40%, transparent 100%);
    }
    .halftone__img--dense {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 260ms ease;
    }
    @media (hover: hover) {
        .halftone--hover:hover .halftone__img--dense {
            opacity: 1;
        }
    }
</style>
