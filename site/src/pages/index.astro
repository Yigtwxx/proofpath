---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Terminal from '../components/Terminal.astro';
import Chapter from '../components/Chapter.astro';
import Rules from '../components/Rules.astro';
import Ci from '../components/Ci.astro';
import Footer from '../components/Footer.astro';
import InstallBox from '../components/InstallBox.astro';
import Reads from '../components/Reads.astro';
import Posts from '../components/Posts.astro';
import Measured from '../components/Measured.astro';
import Judge from '../components/Judge.astro';
import Cache from '../components/Cache.astro';
import Limits from '../components/Limits.astro';
import SketchArrow from '../components/sketch/SketchArrow.astro';
import { levels } from '../data/levels';

const title = "proofpath — Don't guess. Show the evidence.";
const description =
    'proofpath checks whether the sources behind a claim actually say what the claim says: does the source exist, is it still valid, does it support the claim. Local, free, no API key.';
---

<Layout title={title} description={description}>
    <Nav />
    <div class="hero-shell" data-nav-hero>
        <Hero />
    </div>
    <main id="main">
        <Section id="run" title="A run, as it happens.">
            <div class="run" data-run>
                <Terminal />
                <aside class="run__notes" aria-label="What to look at in the run" data-run-notes>
                    <!-- The section's margin note, moved down beside the run it
                         introduces instead of floating above the heading. -->
                    <p class="marginalia run__lede" data-run-lede>
                        Seven references from a draft. One of them does not exist. One says 3.5 days
                        where the draft says 21.
                    </p>
                    <div class="run__note" data-note-for="stages">
                        <SketchArrow direction="curve-left" size={56} />
                        <p class="marginalia">
                            Every stage names the provider that produced its number, and how long it
                            took.
                        </p>
                    </div>
                    <div class="run__note" data-note-for="ghost">
                        <SketchArrow direction="curve-left" size={56} />
                        <p class="marginalia">
                            A ghost call comes with the list of indexes that were asked first.
                        </p>
                    </div>
                    <div class="run__note" data-note-for="you">
                        <SketchArrow direction="curve-left" size={56} />
                        <p class="marginalia">
                            <b>you</b> is your sentence; <b>source</b> is theirs. The verdict sits
                            between them, never without them.
                        </p>
                    </div>
                    <div class="run__note" data-note-for="coverage">
                        <SketchArrow direction="curve-left" size={56} />
                        <p class="marginalia">
                            The last lines are the coverage: how much of this verdict is standing on
                            text that was actually read.
                        </p>
                    </div>
                </aside>
            </div>
        </Section>

        <Section
            id="levels"
            title="Three questions, asked in order."
            margin="Most tools stop at the first. The third is the point."
        >
            {levels.map((level) => (
                <Chapter level={level} />
            ))}
        </Section>

        <Section
            id="reads"
            ruled
            title="What it reads."
            margin="Most of it needs no key at all. What cannot be read is said out loud, never skipped."
        >
            <Reads />
        </Section>

        <Section
            id="rules"
            field="crimson"
            title="Six things it will never do."
            margin="These are not preferences. Breaking one breaks the reason the tool exists."
        >
            <Rules />
        </Section>

        <Section
            id="posts"
            title="A post is not a source."
            margin="What it checks is whether the links inside the post back what it says. The post's own words never count as evidence for themselves."
        >
            <Posts />
        </Section>

        <Section
            id="measured"
            field="crimson"
            title="Measured, not claimed."
            margin="No number is quoted without the run that produced it. The row in the box is the one to read before pointing this at the news."
        >
            <Measured />
        </Section>

        <Section
            id="limits"
            title="Where it stops, today."
            margin="A tool that measures its own coverage also has to say what it does not read yet."
        >
            <Limits />
        </Section>

        <Section
            id="install"
            ruled
            title="The same engine behind a pipe."
            margin="A report, a JSON document, a SARIF log — and an exit code you can gate on."
        >
            <div class="install-row">
                <InstallBox id="page-install" />
                <p class="install-row__fine">
                    Python 3.10+. The first run downloads about 250 MB of ONNX models once; the{' '}
                    <code>[gpu]</code> extra adds
                    <code>torch</code> for CUDA, MPS and CPU, in that order. Nothing else is
                    installed without asking.
                </p>
            </div>
            <Ci />
            <Cache />
            <Judge />
        </Section>
    </main>
    <Footer />
</Layout>

<script>
    import { initRunNotes } from '../scripts/run-notes';
    initRunNotes();
</script>

<style>
    .hero-shell {
        --field: var(--crimson);
        background: var(--crimson);
        color: var(--paper);
    }
    /* Two columns only from 80rem: narrower, the notes column is too slim for each
       note to sit beside its own lines, so they go under the terminal instead. */
    .run {
        display: grid;
        gap: var(--space-5);
        align-items: start;
    }
    @media (min-width: 80rem) {
        .run {
            grid-template-columns: minmax(0, 1fr) var(--margin-col);
            gap: var(--space-6);
        }
    }
    .run__notes {
        display: grid;
        gap: var(--space-5);
        padding-top: var(--space-6);
    }
    @media (min-width: 80rem) {
        .run__notes {
            grid-template-rows: repeat(5, auto);
            align-content: space-between;
            height: 100%;
        }
    }
    .run__note {
        display: flex;
        gap: var(--space-2);
        align-items: flex-start;
    }
    .run__note .marginalia,
    .run__lede {
        margin: 0;
    }
    /* The arrow keeps its size: a long note would otherwise squeeze it to a tick. */
    .run__note :global(.sketch-arrow) {
        flex: none;
    }
    /* scripts/run-notes.ts: each note pinned beside the line it points at, shown
       once that line has been typed. */
    @media (min-width: 80rem) {
        .run--anchored .run__notes {
            display: block;
            position: relative;
            height: auto;
            padding-top: 0;
        }
        .run--anchored .run__note {
            position: absolute;
            inset-inline: 0;
            top: var(--note-top, 0);
            opacity: 0;
            transition:
                opacity 400ms ease,
                top 300ms ease;
        }
        .run--anchored .run__note.is-shown {
            opacity: 1;
        }
        /* A little smaller than elsewhere, so each note is short enough to sit on
           its own lines without covering its neighbour's. */
        .run--anchored .run__note :global(.sketch-arrow) {
            width: 2.5rem;
            height: 2.5rem;
        }
        .run--anchored .run__note .marginalia {
            /* 90% of the .marginalia size (global.css). */
            font-size: calc(var(--step-1) * 1.05 * 0.9);
        }
    }
    @media (min-width: 80rem) and (prefers-reduced-motion: reduce) {
        .run--anchored .run__note {
            transition: none;
        }
    }
    .install-row {
        display: grid;
        gap: var(--space-5);
        align-items: center;
        margin-bottom: var(--space-7);
    }
    @media (min-width: 64rem) {
        .install-row {
            grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
            gap: var(--space-7);
        }
    }
    .install-row__fine {
        font-size: var(--step--1);
        color: var(--ink-soft);
        margin: 0;
    }
</style>
